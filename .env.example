NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lembrete diário por e-mail (veja o final do DEPLOY.md). Configure estas variáveis na Vercel:
# RESEND_API_KEY=re_...                    # chave do Resend (resend.com)
# SUPABASE_SERVICE_ROLE_KEY=               # chave "service_role" do Supabase (SECRETA: só no servidor)
# CRON_SECRET=                             # um texto longo e aleatório, só seu
# EMAIL_FROM=R1TMO <lembretes@r1tmo.com.br>   # remetente (domínio verificado no Resend)

# Entrar com o Google: deixe vazio até configurar o Google no Supabase (veja DEPLOY.md); depois, LOGIN_GOOGLE=ligado
LOGIN_GOOGLE=

# Endereço principal (veja "Domínio próprio" no DEPLOY.md). Só na Vercel, depois que o domínio abrir:
# DOMINIO_PRINCIPAL=r1tmo.com.br             # r1tmo.vercel.app passa a levar para cá
# SITE_URL=https://r1tmo.com.br              # links dos e-mails de lembrete
